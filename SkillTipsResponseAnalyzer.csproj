<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsUraPlugin>true</IsUraPlugin>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Version>2026.11.6</Version>
    <DefaultItemExcludes>$(DefaultItemExcludes);artifacts/**;tests/**</DefaultItemExcludes>

    <!-- URA 插件元数据 -->
    <PluginInternalName>SkillTipsResponseAnalyzer</PluginInternalName>
    <PluginDisplayName>育成结束时给出评分最大化的技能点法</PluginDisplayName>
    <PluginAuthor>离披&amp;Github Contributors</PluginAuthor>
    <PluginDescription>育成结束时联合计算技能购买与进化的预计评价方案。</PluginDescription>
    <PluginRepositoryUrl>https://github.com/URA-Plugins/SkillTipsResponseAnalyzer</PluginRepositoryUrl>
    <PluginChangelog>属性评分改用 Database.StatusToPoint(int) 全段公式，修正部分 2000 以上属性的 1 分偏差并取消 2500 上限。1114 个独立历史状态与服务器总分一致；高段实测仅覆盖速度、最高 2338，其他高段按公式外推。需要包含 SDK 2026.11.6 对应接口的 Host，旧接口插件须配套重编。</PluginChangelog>
  </PropertyGroup>

  <ItemGroup>
    <Compile Update="i18n\ParseSkillTipsResponse.Designer.cs">
      <DependentUpon>ParseSkillTipsResponse.resx</DependentUpon>
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Update="i18n\ParseSkillTipsResponse.resx">
      <LastGenOutput>ParseSkillTipsResponse.Designer.cs</LastGenOutput>
      <Generator>PublicResXFileCodeGenerator</Generator>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="UmamusumeResponseAnalyzer" Version="*" PrivateAssets="all" />
    <PackageReference Include="Google.OrTools" Version="9.15.6755" />
  </ItemGroup>

</Project>
